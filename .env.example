# Required for building and voice input. Create a key at https://console.groq.com/keys
# Without it the bundled sample still opens.
GROQ_API_KEY=

# Optional. Lower this if your Groq plan rejects large requests.
# GROQ_MAX_OUTPUT_TOKENS=4500

# Optional. Override the models if Groq retires the defaults.
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# GROQ_MODEL_SPEECH=whisper-large-v3-turbo
